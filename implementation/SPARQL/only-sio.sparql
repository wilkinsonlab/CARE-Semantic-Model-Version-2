PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ordo: <http://www.orpha.net/ORDO/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?patient_id
WHERE {
    GRAPH ?record {
      ?person sio:SIO_000228 ?role .
      ?role a sio:SIO_000016 ;
            sio:SIO_000356 ?process .

      ?id sio:SIO_000020 ?role ;
          sio:SIO_000300 ?patient_id .

      ?process a sio:SIO_000006;
               sio:SIO_000229 ?output .

      # All of the below are model-specific / optional structural
      # branches -- none exist on every Process_/Output_, so none may be
      # required unconditionally.
      OPTIONAL { ?process sio:SIO_000291 ?target . ?target a sio:SIO_000015 . }
      OPTIONAL { ?process sio:SIO_000230 ?input . ?input a sio:SIO_000015 . }
      OPTIONAL { ?process sio:SIO_000900 ?frequency . ?frequency a sio:SIO_001367 . }
      OPTIONAL { ?process sio:SIO_000339 ?protocol . ?protocol a sio:SIO_000090 . }
      OPTIONAL { ?process sio:SIO_000028 ?specific_method . ?specific_method a sio:SIO_000006 . }

      ?output a sio:SIO_000015 .

      # refers to Attribute_ -- present only when this model has an
      # attribute to report (and, for Phenotype/Diagnosis, only when the
      # result is affirmative).
      OPTIONAL {
        ?output sio:SIO_000628 ?attribute .
        ?attribute a sio:SIO_000614 ; sio:SIO_000680 ?duration_startdate ; sio:SIO_000681 ?duration_enddate .
        ?duration_startdate a sio:SIO_000031 .
        ?duration_enddate a sio:SIO_000032 .
      }

      OPTIONAL { ?output sio:SIO_000221 ?unit . ?unit a sio:SIO_000074 . }
      OPTIONAL { ?output sio:SIO_000671 ?output_identifier . ?output_identifier a sio:SIO_000115 . }
      OPTIONAL { ?output sio:SIO_000243 ?cause . ?cause a sio:SIO_000015 . }
    }

  ?record a sio:SIO_001027 ;
            rdfs:label ?record_label ;
            sio:SIO_000680 ?startdate ;
            sio:SIO_000681 ?enddate ;
            sio:SIO_000687 ?age ;
            sio:SIO_000300 ?record_id ;
            sio:SIO_000253 ?organisation;
            sio:SIO_000068 ?medical_history, ?event .

    ?medical_history a sio:SIO_010673 ;
                     sio:SIO_000332 ?person_timeline .
    ?person_timeline a sio:SIO_000498 ;
                     sio:SIO_000671 ?person_identifier .
    ?person_identifier a sio:SIO_000115 ;
                       sio:SIO_000300 ?patient_id .

    ?event a sio:SIO_000088 .
    ?age a sio:SIO_001013 .
    ?startdate a sio:SIO_000031 .
    ?enddate a sio:SIO_000032 .
    ?organisation a sio:SIO_000012.
  }
